--- /dev/null
+++ b/utils/screen-size.js
@@ -0,0 +1,11 @@
+export const getScreenSize = () => {
+    if (window.innerWidth >= 1200) {
+        return "desktop";
+    }
+
+    if (window.innerWidth >= 768) {
+        return "tablet";
+    }
+
+    return "mobile";
+};
